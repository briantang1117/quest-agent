{
  "name": "quest-frontend",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev:pc": "pnpm --filter @quest/pc-web dev",
    "dev:mobile": "pnpm --filter @quest/mobile-agent dev",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @quest/shared test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @quest/pc-web --filter @quest/mobile-agent build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.2"
  }
}
