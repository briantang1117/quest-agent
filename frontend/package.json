{
  "name": "quest-frontend",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev:pc": "pnpm --filter @quest/pc-web dev",
    "dev:mobile": "pnpm --filter @quest/mobile-agent dev",
    "test": "pnpm --filter @quest/shared test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @quest/pc-web --filter @quest/mobile-agent build"
  }
}
