# Copy to .env.local in this app directory. Values are public, never put secrets here.
# Leave empty to disable all service requests.
VITE_API_BASE_URL=
# VITE_API_BASE_URL=/gateway
# DEV_API_PROXY_TARGET=http://localhost:8080
# Production behind a same-origin Java gateway: VITE_API_BASE_URL=/
# Java service root only; proxy is dev-only. Production needs a same-origin gateway or CORS.
DEV_API_PROXY_TARGET=
