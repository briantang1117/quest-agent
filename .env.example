# 复制为根目录 .env，自行生成独立随机密码；禁止提交真实值。
# docker compose --env-file .env -f deploy/docker-compose.yml ...
PG_ADMIN_PASSWORD=
PG_OWNER_PASSWORD=
PG_APP_PASSWORD=
PG_AI_PASSWORD=
REDIS_PASSWORD=
# 以下密钥分别生成，不复用；至少 32 个随机字符（JWT 建议 64 位 hex）。
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
INTERNAL_HMAC_SECRET=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
STORAGE_ENDPOINT=http://nas.quest.lan:9000
STORAGE_PUBLIC_ENDPOINT=http://nas.quest.lan:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# NAS 专用：仅 NAS Compose 使用，业务服务不使用 root 凭据。
MINIO_ROOT_USER=questadmin
MINIO_ROOT_PASSWORD=
NAS_DATA_DIR=/volume1/quest-oss
HTTP_PORT=8088
