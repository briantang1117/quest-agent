# 复制为 .env.api.properties，工作目录设为 backend，使用Java Properties语法。
# 不使用shell source；空格/引号不是dotenv语法，密码含反斜杠需写成\\。
SPRING_PROFILES_ACTIVE=deployment
SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.3.40:15432/quest
SPRING_DATASOURCE_USERNAME=quest_app
SPRING_DATASOURCE_PASSWORD=
spring.datasource.hikari.maximum-pool-size=5
# 日常启动不执行数据库迁移。
SPRING_FLYWAY_ENABLED=false
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_USER=quest_owner
SPRING_FLYWAY_PASSWORD=
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
INTERNAL_HMAC_SECRET=
AI_SERVICE_URL=http://127.0.0.1:8000
# 只有V5升级、Python接口与计费范围确认后才手工开启；默认不外发导入材料。
quest.public-import.enabled=false
# V13、RocketMQ Topic与Worker验收后另行开启；关闭时禁止接单和领取付费任务。
quest.materials.enabled=false
quest.materials.max-input-chars=1000000
quest.materials.max-snapshot-bytes=8388608
quest.materials.ai-timeout=PT650S
REDIS_HOST=192.168.3.40
REDIS_PORT=16379
REDIS_PASSWORD=
ROCKETMQ_NAME_SERVER=192.168.3.40:9876
STORAGE_ENDPOINT=http://192.168.3.40:19000
STORAGE_PUBLIC_ENDPOINT=http://192.168.3.40:19000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
server.address=127.0.0.1
server.port=8080

# 默认使用Python LangGraph练习编排；false显式回滚旧Java编排。
quest.coach.harness.enabled=true

# V14账号续期；本机HTTP为false，HTTPS部署必须设true。
quest.security.access-seconds=900
quest.security.refresh.secure=false
