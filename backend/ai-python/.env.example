# 复制为本工程.env。uv run --env-file .env或PyCharm运行配置显式加载。
APP_ENV=production
INTERNAL_SERVICE_TOKEN=
INTERNAL_HMAC_SECRET=
# 文本模型：灵思亮界OpenAI兼容入口。Base URL按当前文档站点预填，待联调确认API Host。
# Key由你填写；不与图片/向量/搜索服务共用或自动回退。
TEXT_LLM_BASE_URL=https://apistore.thinklight.com.cn/v1
TEXT_LLM_API_KEY=
TEXT_LLM_MODEL=deepseek-v4.1-flash
# DeepSeek独立搜索/网页抓取工具；各填各的Key，无MODEL字段。
# 完整路径分别为/v1/tools/search与/v1/tools/fetch，调用逻辑尚未接入。
SEARCH_API_BASE_URL=https://api.deepseek.com/v1
SEARCH_API_KEY=
FETCH_API_BASE_URL=https://api.deepseek.com/v1
FETCH_API_KEY=

# 方舟Agent调试地址，是否支持文档/向量端点待真实联调，不自动切换正式地址。
OCR_API_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
OCR_API_KEY=
OCR_MODEL=doubao-seed-2.1-pro
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
EMBEDDING_API_KEY=
EMBEDDING_MODEL=doubao-embedding-vision
# 向量输出维度待验证，暂不填写；当前PG表vector(1024)，不自动改表。
# EMBEDDING_DIMENSIONS=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4096
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
