# 复制为本工程.env。uv run --env-file .env或PyCharm运行配置显式加载。
APP_ENV=production
INTERNAL_SERVICE_TOKEN=
INTERNAL_HMAC_SECRET=
# 文本模型：灵思亮界OpenAI兼容入口。Base URL按当前文档站点预填，待联调确认API Host。
# Key由你填写；不与图片/向量/搜索服务共用或自动回退。
TEXT_LLM_BASE_URL=https://apistore.thinklight.com.cn/v1
TEXT_LLM_API_KEY=
TEXT_LLM_MODEL=deepseek-v4.1-flash
# DeepSeek独立搜索/网页抓取工具；各填各的Key，无MODEL字段。
# 完整路径分别为/v1/tools/search与/v1/tools/fetch，陪练工具循环按需调用。
SEARCH_API_BASE_URL=https://api.deepseek.com/v1
SEARCH_API_KEY=
FETCH_API_BASE_URL=https://api.deepseek.com/v1
FETCH_API_KEY=

# 方舟Agent调试地址，是否支持文档/向量端点待真实联调，不自动切换正式地址。
OCR_API_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
OCR_API_KEY=
OCR_MODEL=doubao-seed-2.1-pro
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
EMBEDDING_API_KEY=
EMBEDDING_MODEL=doubao-embedding-vision
# 向量输出维度待验证，暂不填写；当前PG表vector(1024)，不自动改表。
# EMBEDDING_DIMENSIONS=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4096
# 资料整理独立长上下文预算，不放大普通聊天。
MATERIAL_MAX_INPUT_CHARS=1000000
MATERIAL_MAX_INPUT_BYTES=8388608
MATERIAL_MAX_OUTPUT_CHARS=100000
MATERIAL_MAX_OUTPUT_TOKENS=32768
MATERIAL_MAX_STREAM_BYTES=16777216
# PDF中文字体；留空自动查找macOS Arial Unicode / Linux文泉驿 / Windows微软雅黑。
MATERIAL_PDF_FONT_PATH=
MATERIAL_PDF_BOLD_FONT_PATH=
MATERIAL_LLM_TIMEOUT_SECONDS=600
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# 单轮工具执行预算；更改后重启Python服务，原有.env无需用模板覆盖。
COACH_MAX_TOOL_CALLS=12
COACH_MAX_TOOL_ROUNDS=6

# Python编排受控调用Java业务工具；本机默认即可，容器需填可达的API地址。
COACH_API_URL=http://127.0.0.1:8080
# 本机LangGraph图检查点，不是业务数据库；不自动恢复付费调用。
COACH_CHECKPOINT_PATH=runtime/coach-checkpoints.sqlite

# V14迁移与用户额度准备后启用；逐供应商请求计量，缺少usage保持预占。
AI_METERING_ENABLED=false
